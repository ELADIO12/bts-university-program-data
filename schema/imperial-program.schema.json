{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imperial undergraduate 2027 factual source catalog",
  "type": "object",
  "required": ["source_directory", "directory_listing_count", "course_page_count", "record_count", "verification_date", "source_note", "records"],
  "additionalProperties": false,
  "properties": {
    "source_directory": {"const": "https://www.imperial.ac.uk/study/courses/?courseType=undergraduate"},
    "directory_listing_count": {"type": "integer", "minimum": 1},
    "course_page_count": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "verification_date": {"type": "string", "format": "date"},
    "source_note": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "nullableText": {"type": ["string", "null"]},
    "nullableList": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_url", "listing_number", "option_index", "title", "qualification", "duration", "start_date", "study_mode", "locations", "department", "ucas_code", "minimum_entry_standard", "overseas_fee", "application_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^imperial-[a-z0-9]+(?:-[a-z0-9]+)+$"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.imperial\\.ac\\.uk/study/courses/undergraduate/2027/[^?#]+/$"},
        "listing_number": {"type": "integer", "minimum": 1},
        "option_index": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "duration": {"$ref": "#/$defs/nullableText"},
        "start_date": {"$ref": "#/$defs/nullableText"},
        "study_mode": {"$ref": "#/$defs/nullableText"},
        "locations": {"$ref": "#/$defs/nullableList"},
        "department": {"$ref": "#/$defs/nullableText"},
        "ucas_code": {"$ref": "#/$defs/nullableText"},
        "minimum_entry_standard": {"$ref": "#/$defs/nullableList"},
        "overseas_fee": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["amount_gbp", "period", "entry_year", "academic_year"],
             "properties": {
               "amount_gbp": {"type": "integer", "minimum": 1},
               "period": {"enum": ["year", null]},
               "entry_year": {"const": 2027},
               "academic_year": {"type": "null"}
             }}
          ]
        },
        "application_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
